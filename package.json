{
  "name": "bs-vite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "update": "./scripts/update.sh",
    "start_server": "pm2 start \"yarn preview\" --name \"medik\"",
    "sync": "browser-sync start -p 'https://test.altuofianco.com/' --files '**/*.php', 'dist/assets/*.js, dist/assets/*.css, dist/manifest.json' --port 4000 --reload-delay 1500",
    "predev": "sed -i -e 's/vite_dev = false;/vite_dev = true;/g' functions.php && sed -i -e 's/-hash/-build/g' 'vite.config.js' && sed -i -e 's/-hash/-build/g' 'inc/inc.vite.php'",
    "dev": "cross-env NODE_ENV=development vite",
    "prebuild": "sed -i -e 's/vite_dev = true;/vite_dev = false;/g' functions.php && npx stylelint '**/*.scss' --fix && vue-tsc --noEmit && eslint .",
    "build": "vite build",
    "watch": "vite build --watch",
    "preview": "npm-run-all --parallel sync watch",
    "clean": "rm -rf node_modules && rm -f yarn.lock && rm package-lock.json && rm pnpm-lock.yaml",
    "restart": "yarn clean && yarn install && yarn dev",
    "format:scss": "npx stylelint '**/*.scss' --fix",
    "type:check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "autoprefixer": "^10.4.13",
    "browser-sync": "^2.27.11",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.6.2",
    "typescript-eslint": "^8.50.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.20",
    "postcss-nested": "^6.0.0",
    "sass": "^1.58.0",
    "typescript": "~5.6",
    "vite": "^7.3.1",
    "vite-plugin-live-reload": "^3.0.5",
    "vue-tsc": "^3.0.7"
  },
  "dependencies": {
    "@types/lodash": "^4.17.21",
    "@vue-leaflet/vue-leaflet": "^0.6.0",
    "@vuelidate/core": "^2.0.0",
    "@vuelidate/validators": "^2.0.0",
    "@vuepic/vue-datepicker": "^4.2.1",
    "@vueuse/core": "^9.13.0",
    "baseline-browser-mapping": "^2.10.0",
    "caniuse-lite": "^1.0.30001777",
    "gsap": "^3.5.1",
    "lazysizes": "^5.3.2",
    "leaflet": "^1.9.3",
    "lodash": "^4.17.21",
    "pinia": "^3.0.4",
    "stylelint": "^16.21.1",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-order": "^7.0.0",
    "stylelint-scss": "^6.12.1",
    "vanilla-lazyload": "latest",
    "vue": "^3.2.45",
    "vue-currency-input": "^3.0.3",
    "vue3-carousel": "^0.2.9"
  },
  "engines": {
    "node": "22.*"
  }
}

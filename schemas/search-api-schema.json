{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SearchApi",
  "type": "object",
  "properties": {
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "img": {
            "type": "boolean"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "img",
          "slug"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "pages"
  ]
}